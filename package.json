{
  "name": "@porbit/style",
  "version": "1.1.0",
  "description": "PresenceStyle: utility CSS engine mở — parse class runtime, sinh CSS theo layer/media, trích xuất CSS tĩnh, bộ component mẫu và MCP server cho agent AI.",
  "type": "commonjs",
  "license": "Apache-2.0",
  "author": "vuits24",
  "keywords": [
    "presence",
    "presence-style",
    "porbit",
    "css",
    "css-in-js",
    "utility",
    "atomic-css",
    "utility-first",
    "static-extraction",
    "ssr",
    "typescript",
    "x-css",
    "components",
    "design-system",
    "mcp",
    "model-context-protocol",
    "vite-plugin",
    "webpack-plugin",
    "nextjs",
    "tailwindcss",
    "tailwind-runtime"
  ],
  "homepage": "https://github.com/porbit/style#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/porbit/style.git"
  },
  "bugs": {
    "url": "https://github.com/porbit/style/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index-auto.mjs",
  "jsdelivr": "./dist/index-auto.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./auto": {
      "types": "./dist/index-auto.d.ts",
      "import": "./dist/index-auto.mjs",
      "require": "./dist/index-auto.js",
      "default": "./dist/index-auto.mjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.mjs",
      "require": "./dist/components.js",
      "default": "./dist/components.mjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.mjs",
      "require": "./dist/tailwind.js",
      "default": "./dist/tailwind.mjs"
    },
    "./tailwind-v4": {
      "types": "./dist/tailwind-v4.d.ts",
      "import": "./dist/tailwind-v4.mjs",
      "require": "./dist/tailwind-v4.js",
      "default": "./dist/tailwind-v4.mjs"
    },
    "./tailwind-auto": {
      "types": "./dist/tailwind-auto.d.ts",
      "import": "./dist/tailwind-auto.mjs",
      "require": "./dist/tailwind-auto.js",
      "default": "./dist/tailwind-auto.mjs"
    },
    "./tailwind-plugins": {
      "types": "./dist/tailwind-plugins.d.ts",
      "import": "./dist/tailwind-plugins.mjs",
      "require": "./dist/tailwind-plugins.js",
      "default": "./dist/tailwind-plugins.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.js",
      "default": "./dist/vite.mjs"
    },
    "./shorten": {
      "types": "./dist/shorten.d.ts",
      "import": "./dist/shorten.mjs",
      "require": "./dist/shorten.js",
      "default": "./dist/shorten.mjs"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "import": "./dist/webpack.mjs",
      "require": "./dist/webpack.js",
      "default": "./dist/webpack.mjs"
    },
    "./webpack-loader": "./dist/webpack-loader.cjs",
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.mjs",
      "require": "./dist/next.js",
      "default": "./dist/next.mjs"
    },
    "./analyze": {
      "types": "./dist/analyze.d.ts",
      "import": "./dist/analyze.mjs",
      "require": "./dist/analyze.js",
      "default": "./dist/analyze.mjs"
    },
    "./lsp": {
      "types": "./dist/lsp.d.ts",
      "import": "./dist/lsp.mjs",
      "require": "./dist/lsp.js",
      "default": "./dist/lsp.mjs"
    },
    "./prettier": {
      "types": "./dist/prettier.d.ts",
      "import": "./dist/prettier.mjs",
      "require": "./dist/prettier.js",
      "default": "./dist/prettier.mjs"
    },
    "./postcss": {
      "types": "./dist/postcss.d.ts",
      "import": "./dist/postcss.mjs",
      "require": "./dist/postcss.cjs",
      "default": "./dist/postcss.mjs"
    },
    "./merge": {
      "types": "./dist/merge.d.ts",
      "import": "./dist/merge.mjs",
      "require": "./dist/merge.js",
      "default": "./dist/merge.mjs"
    },
    "./merge/lite": {
      "types": "./dist/merge-lite.d.ts",
      "import": "./dist/merge-lite.mjs",
      "require": "./dist/merge-lite.js",
      "default": "./dist/merge-lite.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.mjs",
      "require": "./dist/mcp.js",
      "default": "./dist/mcp.mjs"
    },
    "./dictionary.json": "./spec/dictionary.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "presence-style": "./dist/cli-bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "spec/dictionary.json",
    "spec/SPEC.md",
    "docs/guides/thiet-ke-nhanh.md",
    "docs/guides/tu-vung-mo.md",
    "docs/guides/mcp.md",
    "docs/guides/components.md",
    "docs/guides/static-first.md",
    "docs/guides/tailwind.md",
    "llms.txt",
    "README.en.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index-auto.js",
    "./dist/index-auto.mjs",
    "./dist/tailwind-auto.js",
    "./dist/tailwind-auto.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test -c e2e/playwright.config.ts",
    "gen:spec": "node scripts/gen-spec.cjs",
    "gen:rust": "node scripts/gen-rust-dict.cjs",
    "gen": "npm run gen:spec && npm run gen:rust && npm run gen:tailwind && npm run gen:tailwind-plugins && npm run gen:llms",
    "prepublishOnly": "node scripts/check-all.cjs",
    "typecheck": "tsc --noEmit",
    "test:run": "vitest run",
    "extract": "node ./dist/cli-bin.js extract",
    "verify": "npm run typecheck && npm run test:run && npm run build",
    "mcp": "node ./dist/cli-bin.js mcp",
    "gen:llms": "node scripts/gen-llms.cjs",
    "check:all": "node scripts/check-all.cjs",
    "check:quick": "node scripts/check-all.cjs --quick",
    "check:fast": "node scripts/check-all.cjs --fast",
    "check:browser": "npm run build && node scripts/browser-checks.cjs",
    "hooks:install": "git config core.hooksPath .githooks && echo \"Đã bật git hook trong .githooks\"",
    "gen:tailwind": "node scripts/gen-tailwind-map.mjs",
    "gen:tailwind-plugins": "node scripts/gen-tailwind-plugins.mjs",
    "check:tailwind": "npm run build && node eval/tailwind-parity.mjs && node eval/tailwind-variants.mjs && node eval/tailwind-plugins.mjs && node eval/real-project.mjs",
    "eval:real": "node eval/real-project.mjs",
    "check:short-classnames": "npm run build && node eval/short-classnames.mjs",
    "short-classnames": "node eval/short-classnames.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@tailwindcss/browser": "^4.3.5",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/typography": "^0.5.4",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "apca-w3": "^0.1.9",
    "clsx": "^2.1.1",
    "daisyui": "5.8.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "1.0.7",
    "tailwindcss-animated": "^2.1.0",
    "tailwindcss-motion": "^1.1.1",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tsup": "^8.0.0",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  }
}
